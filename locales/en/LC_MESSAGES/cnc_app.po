#: toolbook.py:15
msgid "Fresa plana (end mill)"
msgstr "Flat end mill"

#: toolbook.py:15
msgid "De bola (ball)"
msgstr "Ball nose"

#: toolbook.py:15
msgid "En V"
msgstr "V-bit"

#: toolbook.py:26
msgid "el identificador debe empezar por una letra y usar solo letras, números, '_', '-' o '.' (un número solo se tomaría por un diámetro)."
msgstr "the identifier must start with a letter and use only letters, numbers, '_', '-' or '.' (a lone number would be taken for a diameter)."

#: toolbook.py:56
#, python-brace-format
msgid "'{key}' debe ser un número entero (hay {text!r})."
msgstr "'{key}' must be an integer (got {text!r})."

#: toolbook.py:89
msgid "De momento solo las fresas planas (end mill) generan trayectorias; esta ficha se guarda como datos."
msgstr "For now only flat end mills (end mill) generate toolpaths; this profile is saved as data."

#: toolbook.py:92
#, python-brace-format
msgid "Sin {join}: habrá que escribirlo en cada trabajo."
msgstr "Without {join}: it will have to be written in every job."

#: toolbook.py:94
msgid "Sin longitud útil: la aplicación no puede avisar si un corte es más hondo que el filo."
msgstr "Without a useful length: the application cannot warn if a cut is deeper than the flute."

#: toolbook.py:96
msgid "Sin profundidad de pasada: corta todo el grosor de una vez, salvo que el trabajo diga otra."
msgstr "Without a pass depth: it cuts the whole thickness at once, unless the job says otherwise."

#: toolpath.py:50
msgid "El grosor del material debe ser > 0."
msgstr "The material thickness must be > 0."

#: toolpath.py:54
msgid "La profundidad extra en el sufridor no puede ser negativa."
msgstr "The extra depth in the spoilboard cannot be negative."

#: toolpath.py:57
#, python-brace-format
msgid "Extra en el sufridor ({extra:g} mm) por encima del limite ({max_spoilboard_extra:g} mm)."
msgstr "Extra in the spoilboard ({extra:g} mm) above the limit ({max_spoilboard_extra:g} mm)."

#: toolpath.py:61
msgid "Una operacion no pasante necesita depth > 0."
msgstr "A non-through operation needs depth > 0."

#: toolpath.py:64
#, python-brace-format
msgid "Profundidad {depth:g} mm mayor que el grosor del material ({thickness:g} mm); si quieres cortar del todo usa through=True."
msgstr "Depth {depth:g} mm greater than the material thickness ({thickness:g} mm); if you want to cut all the way through, use through=True."

#: toolpath.py:73
msgid "stepdown debe ser > 0."
msgstr "stepdown must be > 0."

#: toolpath.py:112
msgid "Con side='on' la forma debe ser Polygon o LineString."
msgstr "With side='on' the shape must be a Polygon or a LineString."

#: toolpath.py:115
#, python-brace-format
msgid "side desconocido: {side!r}"
msgstr "unknown side: {side!r}"

#: toolpath.py:122
msgid "outside/inside requieren una forma cerrada."
msgstr "outside/inside require a closed shape."

#: toolpath.py:129
msgid "La fresa es demasiado grande para este contorno."
msgstr "The end mill is too large for this outline."

#: toolpath.py:184
msgid "los puentes solo valen en cortes pasantes."
msgstr "tabs only work in through cuts."

#: toolpath.py:187
#, python-brace-format
msgid "un puente de {height:g} mm de alto no cabe en un material de {thickness:g} mm."
msgstr "a {height:g} mm high tab does not fit in a {thickness:g} mm thick material."

#: tools.py:35
msgid "endmill | ball | v"
msgstr "endmill | ball | v"

#: tools.py:36
