#, python-brace-format
msgid "{where}: 'tipo' debe ser uno de {join} (hay {get!r})."
msgstr "{where}: 'tipo' must be one of {join} (got {get!r})."

#: tools.py:79
#, python-brace-format
msgid "{where}: 'diametro'"
msgstr "{where}: 'diametro'"

#: tools.py:90
#, python-brace-format
msgid "{where}: 'flautas' debe ser un numero entero >= 1 (hay {n!r})."
msgstr "{where}: 'flautas' must be an integer >= 1 (got {n!r})."

#: tools.py:99
#, python-brace-format
msgid "{where}: 'angulo' solo tiene sentido en fresas de tipo v."
msgstr "{where}: 'angulo' only makes sense for v-type end mills."

#: tools.py:102
#, python-brace-format
msgid "{where}: 'angulo' debe estar entre 0 y 180 grados (hay {a!r})."
msgstr "{where}: 'angulo' must be between 0 and 180 degrees (got {a!r})."

#: tools.py:105
#, python-brace-format
msgid "{where}: una fresa de tipo v necesita 'angulo' (grados incluidos, p. ej. 90)."
msgstr "{where}: a v-type end mill needs 'angulo' (included degrees, e.g. 90)."

#: tools.py:110
#, python-brace-format, python-format
msgid "{where}: 'stepover' debe estar entre 0 y 100 (% del diametro) (hay {s!r})."
msgstr "{where}: 'stepover' must be between 0 and 100 (% of the diameter) (got {s!r})."

#: tools.py:113
#, python-brace-format
msgid "{where}: 'stepover' va en porcentaje del diametro (p. ej. 40 para el 40 %), no como fraccion (hay {s!r})."
msgstr "{where}: 'stepover' is a percentage of the diameter (e.g. 40 for 40 %), not a fraction (got {s!r})."

