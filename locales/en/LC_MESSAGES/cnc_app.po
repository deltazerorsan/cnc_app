msgstr "mm (for a V-bit, the maximum cutting diameter)"

#: tools.py:37
msgid "numero de filos"
msgstr "number of flutes"

#: tools.py:38
msgid "mm de filo util"
msgstr "mm of useful flute"

#: tools.py:39
