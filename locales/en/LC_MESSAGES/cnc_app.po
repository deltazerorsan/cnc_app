msgstr "included degrees of the V (v type only)"

#: tools.py:40
msgid "RPM aconsejadas (informativo: el variador se ajusta a mano)"
msgstr "advised RPM (informational: the speed controller is set by hand)"

#: tools.py:41
msgid "mm por pasada"
msgstr "mm per pass"

#: tools.py:42
msgid "mm/min de corte"
msgstr "mm/min cutting"

#: tools.py:43
msgid "mm/min de bajada"
msgstr "mm/min plunge"

#: tools.py:44
#, python-format
msgid "% del diametro entre pasadas (p. ej. 40)"
msgstr "% of the diameter between passes (e.g. 40)"

#: tools.py:49
#, python-format
msgid "Una ficha por fresa. Obligatorio: diametro (mm). Resto opcional: nombre, tipo (endmill | ball | v; la v necesita angulo en grados), flautas, longitud_util (mm), rpm (aconsejadas; solo informativo, el variador se ajusta a mano), profundidad_pasada (mm), feed (mm/min de corte), entrada (mm/min de bajada), stepover (% del diametro, p. ej. 40), notas. Lo que falte se pide por linea de comandos. Para distintos materiales, duplica la ficha con otro nombre (em4_mdf, em4_contra...)."
msgstr "One profile per end mill. Required: diametro (mm). The rest is optional: nombre, tipo (endmill | ball | v; v needs angulo in degrees), flautas, longitud_util (mm), rpm (advised; informational only, the speed controller is set by hand), profundidad_pasada (mm), feed (mm/min cutting), entrada (mm/min plunge), stepover (% of the diameter, e.g. 40), notas. What is missing is asked for on the command line. For different materials, duplicate the profile under another name (em4_mdf, em4_contra...)."

#: tools.py:68
#, python-brace-format
msgid "{where}: debe ser un objeto {{...}} con los campos de la fresa."
msgstr "{where}: must be an object {{...}} with the end mill's fields."

#: tools.py:71
#, python-brace-format
msgid "{where}: falta el campo obligatorio 'diametro' (mm)."
msgstr "{where}: the required field 'diametro' (mm) is missing."

